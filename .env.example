# Copy to .env — never commit the real file.

# Where the DuckDB file and raw HTTP caches live
FF_DATA_DIR=./data

# Seasons to ingest from nflverse (first,last). Prior season supplies positional norms early in the year.
# Leave unset to follow the calendar: (last season, this season), rolling over each June.
# FF_SEASONS=2025,2026

# Market value source: fantasycalc (default) or dynastyprocess
FF_MARKET_SOURCE=fantasycalc

# API base URLs (override only for testing)
FF_SLEEPER_BASE=https://api.sleeper.app/v1
FF_FANTASYCALC_BASE=https://api.fantasycalc.com

# Frontend → backend
VITE_API_BASE=http://localhost:8000

# ESPN (optional) — an alternative to pasting these on the Connect page's ESPN tab.
# Private leagues need both login cookies from fantasy.espn.com (browser dev tools → Cookies).
# They stay on this computer and are only ever sent to ESPN. SWID keeps its curly braces.
# ESPN_LEAGUE_ID=12345678
# ESPN_S2=
# ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
